{
  "manifest_version": 3,
  "name": "AI Web Customizer",
  "version": "1.1",
  "description": "Modify webpage styling using natural language prompts, or restyle a copy of the page in a new tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
