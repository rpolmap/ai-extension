{
  "manifest_version": 3,
  "name": "AI Web Customizer",
  "version": "1.2",
  "description": "Modify webpage styling using natural language prompts.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.groq.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
